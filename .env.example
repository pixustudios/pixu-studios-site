# Copy to .env.local for local work. Never commit real secrets.
# Production: your canonical HTTPS origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Verify your sending domain with Resend first.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=info@pixustudios.com

# Both are required to send enquiries in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional live reviews: billed Google Places API (New).
# Leave disabled until the business listing and legal notices are confirmed.
GOOGLE_REVIEWS_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
